<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <VersionPrefix>0.1.8</VersionPrefix>
    <Product>Rail Narrator</Product>
    <Company>Rail Narrator</Company>
    <Copyright>Copyright (c) Rail Narrator contributors</Copyright>
    <!-- PDFtoImage/SkiaSharp mark APIs platform-specific; this product is desktop-only. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <Deterministic>true</Deterministic>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <!-- Warnings are errors in the libraries that carry the correctness guarantees. The desktop
       host relaxes this because the Avalonia XAML compiler emits advisories we do not control. -->
  <PropertyGroup Condition="'$(RailNarratorTreatWarningsAsErrors)' != 'false'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
