<Project>

  <!--
    Single source of truth for every dependency version. Pinning here rather than in each
    csproj is what makes "the build is reproducible" a checkable claim: one file lists every
    third-party version this product ships with.

    RailReaderCore is pinned to 0.94.0, the version published on nuget.org from upstream commit
    9cf331bde5be8951677afb41d5a6c537cd83c1bb (tag v0.94.0). The investigation in docs/Rail Narrator
    implementation investigation.md inspected 0.89.0 (e7d41208). See docs/decisions/ADR-0001.
  -->
  <ItemGroup>
    <!-- PDF foundation: RailReaderCore. Never replaced by a second PDF stack. -->
    <PackageVersion Include="RailReader.Core" Version="0.94.0" />
    <PackageVersion Include="RailReader.Core.Pdfium" Version="0.94.0" />
    <PackageVersion Include="RailReader.Renderer.Skia" Version="0.94.0" />
    <PackageVersion Include="RailReader.Core.Analysis" Version="0.94.0" />
    <!-- Opt-out GPU layout analysis (ONNX Runtime WebGPU plugin EP 0.6, matched to ORT 1.32). See ADR-0006. -->
    <PackageVersion Include="RailReader.Core.Analysis.WebGpu" Version="0.94.0" />
    <PackageVersion Include="RailReader.Core.Ocr.RapidOcr" Version="0.94.0" />
    <PackageVersion Include="RailReader.Core.Vlm.OpenAI" Version="0.94.0" />
    <!-- Claude for maths, by the reader's choice of provider: Core's IVlmService for the transcriber,
         and the official Anthropic SDK (the version Core 0.94.0 builds against) for interpretation. -->
    <PackageVersion Include="RailReader.Core.Vlm.Anthropic" Version="0.94.0" />
    <PackageVersion Include="Anthropic" Version="13.10.0" />
    <!-- The formula model (PP-FormulaNet_plus-M, ADR-0011) runs in-process on the ONNX Runtime that
         RailReader.Core.Analysis 0.94.0 already brings; pinned here so it stays that one. -->
    <PackageVersion Include="Microsoft.ML.OnnxRuntime" Version="1.32.0" />

    <!-- Pinned to the same 3.119.* RailReader.Renderer.Skia uses, so one native binary serves both. -->
    <PackageVersion Include="SkiaSharp" Version="3.119.4" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux" Version="3.119.4" />

    <!-- Speech. KokoroSharp is the in-process Kokoro runtime; .CPU brings the ONNX native assets.
         Its NAudio/OpenTK.Audio.OpenAL transitive dependencies are for KokoroSharp's own playback,
         which Rail Narrator never calls - playback goes through RailNarrator.Audio. ADR-0002. -->
    <PackageVersion Include="KokoroSharp.CPU" Version="0.8.4" />

    <!-- The saved narration's audio (a .narration file beside the PDF): Opus, encoded and decoded by a
         pure C# port of the reference codec, so neither saving nor offline playback needs a native
         library or ffmpeg. MIT/BSD. -->
    <PackageVersion Include="Concentus" Version="2.2.3" />

    <!-- Desktop. -->
    <PackageVersion Include="Avalonia" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.6" />

    <!-- Tests. -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
