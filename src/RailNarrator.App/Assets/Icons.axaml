    <StreamGeometry x:Key="IconPalette">M13,6.5 A0.5,0.5 0 1 0 14,6.5 A0.5,0.5 0 1 0 13,6.5 Z M0 0 M17,10.5 A0.5,0.5 0 1 0 18,10.5 A0.5,0.5 0 1 0 17,10.5 Z M0 0 M8,7.5 A0.5,0.5 0 1 0 9,7.5 A0.5,0.5 0 1 0 8,7.5 Z M0 0 M6,12.5 A0.5,0.5 0 1 0 7,12.5 A0.5,0.5 0 1 0 6,12.5 Z M0 0 M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2z</StreamGeometry>
    <StreamGeometry x:Key="IconPlay">M6,3 L20,12 L6,21 L6,3 Z</StreamGeometry>
    <StreamGeometry x:Key="IconSettings">M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z M0 0 M9,12.0 A3,3 0 1 0 15,12.0 A3,3 0 1 0 9,12.0 Z</StreamGeometry>
