<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:a="using:Avalonia.Automation"
                    xmlns:controls="using:RailNarrator.App.Controls">

    <!-- Lucide icon geometries (24x24 viewBox, stroked), lucide.dev, ISC licence. The first group is
         copied from RailReader2's Assets/Icons.axaml (MIT, same author), the second converted from
         lucide-static 0.460.0 the same way: each SVG shape one subpath, joined with "M0 0" so a
         relative "m" starts from the origin. -->
    <StreamGeometry x:Key="IconClose">M18 6 6 18 M0 0 m6 6 12 12</StreamGeometry>
    <StreamGeometry x:Key="IconBack">m12 19-7-7 7-7 M0 0 M19 12H5</StreamGeometry>
    <StreamGeometry x:Key="IconForward">M5 12h14 M0 0 M12 5l7 7-7 7</StreamGeometry>
    <StreamGeometry x:Key="IconChevronUp">m18 15-6-6-6 6</StreamGeometry>
    <StreamGeometry x:Key="IconChevronDown">m6 9 6 6 6-6</StreamGeometry>
    <StreamGeometry x:Key="IconChevronLeft">m15 18-6-6 6-6</StreamGeometry>
    <StreamGeometry x:Key="IconChevronRight">m9 18 6-6-6-6</StreamGeometry>
