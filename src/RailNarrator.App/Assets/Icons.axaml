    <StreamGeometry x:Key="IconPencil">M21.174 6.812 A1 1 0 0 0 17.188 2.825 L3.842 16.174 A2 2 0 0 0 3.342 17.004 L2.021 21.356 A0.5 0.5 0 0 0 2.644 21.978 L6.997 20.658 A2 2 0 0 0 7.827 20.161 Z M0 0 M15 5 L19 9</StreamGeometry>
    <StreamGeometry x:Key="IconPlus">M5 12h14 M0 0 M12 5v14</StreamGeometry>
