    <StreamGeometry x:Key="IconCrosshair">M2,12.0 A10,10 0 1 0 22,12.0 A10,10 0 1 0 2,12.0 Z M0 0 M22,12 L18,12 M0 0 M6,12 L2,12 M0 0 M12,6 L12,2 M0 0 M12,22 L12,18</StreamGeometry>
    <StreamGeometry x:Key="IconFolderOpen">m6 14 1.5-2.9A2 2 0 0 1 9.24 10H20a2 2 0 0 1 1.94 2.5l-1.54 6a2 2 0 0 1-1.95 1.5H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h3.9a2 2 0 0 1 1.69.9l.81 1.2a2 2 0 0 0 1.67.9H18a2 2 0 0 1 2 2v2</StreamGeometry>
    <StreamGeometry x:Key="IconGauge">m12 14 4-4 M0 0 M3.34 19a10 10 0 1 1 17.32 0</StreamGeometry>
    <StreamGeometry x:Key="IconMinus">M5 12h14</StreamGeometry>
    <StreamGeometry x:Key="IconMoon">M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z</StreamGeometry>
