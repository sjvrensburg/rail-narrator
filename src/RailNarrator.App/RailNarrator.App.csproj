<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>RailNarrator.App</RootNamespace>
    <AssemblyName>rail-narrator</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The Windows executable's own icon (Explorer, the taskbar before the window sets its own). -->
    <ApplicationIcon>../../packaging/rail-narrator.ico</ApplicationIcon>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- The PDF raster is copied row by row into a WriteableBitmap; unsafe spans avoid a full extra copy. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The Avalonia XAML compiler emits advisories outside this repository's control. -->
    <RailNarratorTreatWarningsAsErrors>false</RailNarratorTreatWarningsAsErrors>
    <!--
      AVLN3001: MainWindow is constructed by the composition root with a
      ServiceRegistry, so it has no parameterless constructor and the XAML previewer
      cannot instantiate it. That is a deliberate consequence of constructor
      injection, not a defect: the window is created in App.OnFrameworkInitializationCompleted
      and never loaded reflectively. Suppressing the advisory rather than adding a
      second constructor that exists only to satisfy a designer.
    -->
    <NoWarn>$(NoWarn);AVLN3001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../RailNarrator.Domain/RailNarrator.Domain.csproj" />
    <ProjectReference Include="../RailNarrator.Pdf/RailNarrator.Pdf.csproj" />
    <ProjectReference Include="../RailNarrator.Speech/RailNarrator.Speech.csproj" />
    <ProjectReference Include="../RailNarrator.Audio/RailNarrator.Audio.csproj" />
    <ProjectReference Include="../RailNarrator.Inference/RailNarrator.Inference.csproj" />
    <ProjectReference Include="../RailNarrator.Infrastructure/RailNarrator.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The mark (window icon, welcome screen, splash), loaded as avares://rail-narrator/Assets/…. -->
    <AvaloniaResource Include="Assets/rail-narrator.png" />
  </ItemGroup>
  <!--
    Kokoro's 54 English voices (Apache-2.0, 27 MB) ship in a release. KokoroSharp's own target copies
    them into a build's output folder only, so a publish left them out and Kokoro found none on a
    clean machine. They are taken from that output folder, which the publish's build has just filled.
    The Kokoro model itself is still never bundled.
  -->
  <Target Name="PublishKokoroVoices" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <!-- The English voices this model speaks, and their licence; voices-zh is another model's. -->
      <KokoroVoice Include="$(OutDir)voices/*.npy" />
      <ResolvedFileToPublish Include="@(KokoroVoice)" RelativePath="voices/%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
      <ResolvedFileToPublish Include="$(OutDir)voices/LICENSE" RelativePath="voices/LICENSE" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
    <Error Condition="'@(KokoroVoice)' == ''" Text="No Kokoro voices in $(OutDir)voices: KokoroSharp's build target did not copy them, and a release without them has no Kokoro voices." />
  </Target>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
  </ItemGroup>
</Project>
