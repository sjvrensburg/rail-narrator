<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RailNarrator.App.ViewModels"
        xmlns:domain="using:RailNarrator.Domain"
        xmlns:views="using:RailNarrator.App.Views"
        xmlns:c="using:RailNarrator.App.Controls"
        x:Class="RailNarrator.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Rail Narrator"
        Width="1440" Height="900"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen">

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenDocument}" />
    <KeyBinding Gesture="Ctrl+OemComma" Command="{Binding OpenSettings}" />
    <!-- Space and Escape are handled in MainWindow.OnPreviewKeyDown, not here: a window-level
         binding also fires while a text box is being typed in or a menu is being dismissed. -->
    <KeyBinding Gesture="Ctrl+P" Command="{Binding PlayPause}" />
    <KeyBinding Gesture="Ctrl+Right" Command="{Binding Next}" />
    <KeyBinding Gesture="Ctrl+Left" Command="{Binding Previous}" />
    <KeyBinding Gesture="Ctrl+R" Command="{Binding Replay}" />
    <KeyBinding Gesture="Ctrl+OemPlus" Command="{Binding ZoomIn}" />
    <KeyBinding Gesture="Ctrl+OemMinus" Command="{Binding ZoomOut}" />
    <KeyBinding Gesture="Ctrl+F" Command="{Binding ToggleFollow}" />
    <KeyBinding Gesture="F9" Command="{Binding ResumeFollow}" />
    <KeyBinding Gesture="F6" Command="{Binding ToggleSidebar}" />
    <KeyBinding Gesture="Ctrl+W" Command="{Binding CloseDocument}" />
    <KeyBinding Gesture="Ctrl+Shift+R" Command="{Binding ReloadDocument}" />
    <KeyBinding Gesture="Ctrl+Add" Command="{Binding ZoomIn}" />
    <KeyBinding Gesture="Ctrl+Subtract" Command="{Binding ZoomOut}" />
    <KeyBinding Gesture="Ctrl+G" Command="{Binding GoToPage}" />
    <KeyBinding Gesture="F1" Command="{Binding ShowShortcuts}" />
  </Window.KeyBindings>

  <Window.Styles>
    <!-- RailReader2's accordion: full-width headers, the open section's content fills its row. -->
    <!-- A recent document whose file is not there now. -->
    <Style Selector="Button.missing">
      <Setter Property="Opacity" Value="0.55" />
    </Style>
    <Style Selector="Expander.accordion">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Margin" Value="0,0,0,1" />
    </Style>
  </Window.Styles>

  <DockPanel>

    <!-- Menu: every command reachable without a pointer -->
    <Menu Name="MainMenu" DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="_Open PDF…" Click="OnOpenClicked" InputGesture="Ctrl+O" />
        <!-- Filled in code-behind from the recent documents (MainWindow.RebuildRecentMenu). -->
        <MenuItem Name="RecentMenu" Header="Open _recent" IsEnabled="{Binding HasRecentDocuments}" />
        <MenuItem Header="Re_load" Command="{Binding ReloadDocument}" InputGesture="Ctrl+Shift+R" />
        <MenuItem Header="_Close" Command="{Binding CloseDocument}" InputGesture="Ctrl+W" />
        <Separator />
        <!-- The whole document narrated once and kept beside it, then played with no model or engine. -->
        <MenuItem Header="Save _narration with document…" Command="{Binding NarrateDocument}"
                  ToolTip.Tip="Interprets the maths and speaks every passage now, and saves the result beside the PDF for playback without a language model or a speech engine" />
        <MenuItem Header="Stop narra_ting" Command="{Binding StopNarration}" />
        <MenuItem Header="Export _audiobook (M4B)…" Command="{Binding ExportAudiobook}"
                  ToolTip.Tip="Writes the saved narration as one audiobook file with a chapter at each heading, beside the PDF (needs ffmpeg)" />
        <Separator />
        <MenuItem Header="_Settings…" Command="{Binding OpenSettings}" InputGesture="Ctrl+OemComma" />
        <Separator />
        <MenuItem Header="E_xit" Click="OnCloseClicked" InputGesture="Ctrl+Q" />
      </MenuItem>
      <MenuItem Header="_Playback">
        <MenuItem Header="_Play / pause" Command="{Binding PlayPause}" InputGesture="Space" ToolTip.Tip="Also Ctrl+P" />
        <Separator />
        <MenuItem Header="Pre_vious passage" Command="{Binding Previous}" InputGesture="Ctrl+Left" />
        <MenuItem Header="_Next passage" Command="{Binding Next}" InputGesture="Ctrl+Right" />
        <MenuItem Header="_Replay passage" Command="{Binding Replay}" InputGesture="Ctrl+R" />
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="_Go to page…" Command="{Binding GoToPage}" InputGesture="Ctrl+G" />
        <Separator />
        <MenuItem Header="Zoom _in" Command="{Binding ZoomIn}" InputGesture="Ctrl+OemPlus" />
        <MenuItem Header="Zoom _out" Command="{Binding ZoomOut}" InputGesture="Ctrl+OemMinus" />
        <MenuItem Header="Fit _width" ToggleType="CheckBox" IsChecked="{Binding FitWidth, Mode=TwoWay}" />
        <MenuItem Header="Zoom _200%" Command="{Binding Zoom200}" />
        <MenuItem Header="Zoom _400%" Command="{Binding Zoom400}" />
        <MenuItem Header="Zoom _800%" Command="{Binding Zoom800}" />
        <Separator />
        <MenuItem Header="_Follow the reading" InputGesture="Ctrl+F"
                  ToggleType="CheckBox" IsChecked="{Binding IsFollowing, Mode=TwoWay}" />
        <MenuItem Header="_Resume following" Command="{Binding ResumeFollow}" InputGesture="F9" />
        <Separator />
        <MenuItem Header="{Binding ColourFilterMenuHeader}">
          <MenuItem Header="_Next colour filter" Click="OnCycleColourFilterClicked" InputGesture="C" />
          <Separator />
          <MenuItem Header="_Off" Tag="None" Click="OnColourFilterClicked" />
          <MenuItem Header="_High contrast (white on black)" Tag="HighContrast" Click="OnColourFilterClicked" />
          <MenuItem Header="High _visibility (yellow on black)" Tag="HighVisibility" Click="OnColourFilterClicked" />
          <MenuItem Header="_Amber" Tag="Amber" Click="OnColourFilterClicked" />
          <MenuItem Header="_Invert" Tag="Invert" Click="OnColourFilterClicked" />
        </MenuItem>
        <Separator />
        <MenuItem Header="Show _annotations" ToggleType="CheckBox" IsChecked="{Binding ShowAnnotations, Mode=TwoWay}" />
        <MenuItem Header="_Expand all notes" ToggleType="CheckBox" IsChecked="{Binding ExpandAllNotes, Mode=TwoWay}" />
        <MenuItem Header="_Sidebar: outline, script, maths review, notes" ToggleType="CheckBox"
                  IsChecked="{Binding SidebarVisible, Mode=TwoWay}" InputGesture="F6" />
      </MenuItem>
      <MenuItem Header="_Review">
        <MenuItem Header="_Note on what was just read…" Command="{Binding NoteOnSentence}" InputGesture="N" />
        <MenuItem Header="Note on the whole _passage…" Command="{Binding NoteOnPassage}" InputGesture="Shift+N" />
        <MenuItem Header="_Highlight what was just read" Command="{Binding HighlightSentence}" InputGesture="H" />
        <MenuItem Header="Highlight the whole p_assage" Command="{Binding HighlightPassage}" InputGesture="Shift+H" />
        <Separator />
        <MenuItem Header="_Undo" Command="{Binding UndoAnnotation}" InputGesture="Ctrl+Z" />
        <MenuItem Header="_Redo" Command="{Binding RedoAnnotation}" InputGesture="Ctrl+Shift+Z" />
        <MenuItem Header="_Delete the selected annotation" Command="{Binding DeleteSelectedAnnotation}" InputGesture="Delete" />
        <Separator />
        <MenuItem Header="_Annotate mode" ToggleType="CheckBox" IsChecked="{Binding AnnotateMode, Mode=TwoWay}" InputGesture="Ctrl+E" />
        <MenuItem Header="_Tool">
          <MenuItem Header="_Highlight" ToggleType="Radio" IsChecked="{Binding IsHighlightTool, Mode=OneWay}" Command="{Binding ChooseTool}" CommandParameter="Highlight" />
          <MenuItem Header="_Underline" ToggleType="Radio" IsChecked="{Binding IsUnderlineTool, Mode=OneWay}" Command="{Binding ChooseTool}" CommandParameter="Underline" />
          <MenuItem Header="_Strike out" ToggleType="Radio" IsChecked="{Binding IsStrikeOutTool, Mode=OneWay}" Command="{Binding ChooseTool}" CommandParameter="StrikeOut" />
          <MenuItem Header="S_quiggle" ToggleType="Radio" IsChecked="{Binding IsSquigglyTool, Mode=OneWay}" Command="{Binding ChooseTool}" CommandParameter="Squiggly" />
          <MenuItem Header="Sticky _note" ToggleType="Radio" IsChecked="{Binding IsTextNoteTool, Mode=OneWay}" Command="{Binding ChooseTool}" CommandParameter="TextNote" />
          <MenuItem Header="Te_xt box" ToggleType="Radio" IsChecked="{Binding IsFreeTextTool, Mode=OneWay}" Command="{Binding ChooseTool}" CommandParameter="FreeText" />
          <MenuItem Header="_Pen" ToggleType="Radio" IsChecked="{Binding IsPenTool, Mode=OneWay}" Command="{Binding ChooseTool}" CommandParameter="Pen" />
          <MenuItem Header="_Box" ToggleType="Radio" IsChecked="{Binding IsRectangleTool, Mode=OneWay}" Command="{Binding ChooseTool}" CommandParameter="Rectangle" />
          <MenuItem Header="E_raser" ToggleType="Radio" IsChecked="{Binding IsEraserTool, Mode=OneWay}" Command="{Binding ChooseTool}" CommandParameter="Eraser" />
          <MenuItem Header="S_elect" ToggleType="Radio" IsChecked="{Binding IsSelectTool, Mode=OneWay}" Command="{Binding ChooseTool}" CommandParameter="None" />
        </MenuItem>
      </MenuItem>
      <MenuItem Header="_Maths">
        <MenuItem Header="Mark this passage as _maths" Command="{Binding MarkAsMaths}" />
        <MenuItem Header="Restore this passage as _prose" Command="{Binding RestoreAsProse}" />
        <MenuItem Header="_Regenerate narration" Command="{Binding RegenerateMaths}" />
      </MenuItem>
      <!-- A model already installed is named as such and its download is disabled. The menu re-reads
           the models directory each time it opens (MainWindow: RefreshModelMenu). -->
      <MenuItem Name="ModelsMenu" Header="M_odels and endpoints">
        <MenuItem Header="{Binding DownloadKokoroModelHeader}" Command="{Binding DownloadKokoroModel}" ToolTip.Tip="Kokoro-82M FP16: speech on this computer" />
        <MenuItem Header="{Binding DownloadKokoroTimedModelHeader}" Command="{Binding DownloadKokoroTimedModel}" ToolTip.Tip="Kokoro-82M FP16 with phoneme durations: word timing from the model itself, with no aligner. Used when Settings ▸ Reading ▸ Word timing is set to the speech engine's own" />
        <MenuItem Header="{Binding DownloadLayoutModelHeader}" Command="{Binding DownloadLayoutModel}" ToolTip.Tip="Docling Heron INT8: finds headings, figures, tables and equations (on the CPU)" />
        <MenuItem Header="{Binding DownloadLayoutModelGpuHeader}" Command="{Binding DownloadLayoutModelGpu}" ToolTip.Tip="Docling Heron FP32: the layout model on a WebGPU-capable GPU" />
        <MenuItem Header="{Binding DownloadFormulaModelHeader}" Command="{Binding DownloadFormulaModel}" ToolTip.Tip="PP-FormulaNet_plus-M: reads display equations to LaTeX on this computer" />
        <Separator />
        <MenuItem Header="_Endpoints and API keys…" Command="{Binding OpenMathsSettings}" />
        <MenuItem Header="_Test text LLM endpoint" Command="{Binding TestMathEndpoint}" />
        <MenuItem Header="Test _vision endpoint" Command="{Binding TestVisionEndpoint}" />
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="_Keyboard shortcuts" Command="{Binding ShowShortcuts}" InputGesture="F1" />
        <Separator />
        <MenuItem Header="_About Rail Narrator" Command="{Binding ShowAbout}" />
      </MenuItem>
    </Menu>

    <!-- Toolbar: what a listener reaches for. Transport, voice and speed; following and the
         colour filter; settings at the far end. Page and zoom are in the status bar, as in
         RailReader2. Icon buttons carry their name for screen readers and their shortcut in the
         tooltip. -->
    <Border DockPanel.Dock="Top" Padding="8,6" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto">
        <!-- Wraps rather than clipping, so nothing becomes unreachable in a narrow window. -->
        <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="4" VerticalAlignment="Center">
          <ToggleButton Classes="toolBtn borderless" IsChecked="{Binding SidebarVisible, Mode=TwoWay}"
                        ToolTip.Tip="Sidebar: outline, script, maths review and notes (F6)"
                        AutomationProperties.Name="Sidebar">
            <c:Icon Data="{StaticResource IconPanelLeft}" />
          </ToggleButton>
          <!-- The open document, as RailReader2's tab (one document at a time here). -->
          <Border IsVisible="{Binding HasDocument}" Padding="10,4" CornerRadius="5,5,0,0" VerticalAlignment="Stretch"
                  Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                  BorderBrush="{DynamicResource SystemControlHighlightAccentBrush}" BorderThickness="0,2,0,0"
                  ToolTip.Tip="{Binding DocumentPath}">
            <TextBlock Text="{Binding DocumentName}" FontWeight="SemiBold" VerticalAlignment="Center"
                       MaxWidth="260" TextTrimming="CharacterEllipsis" />
          </Border>

          <Border Classes="toolSep" />

          <Button Classes="toolBtn" Command="{Binding Previous}" ToolTip.Tip="Previous passage (Ctrl+Left)"
                  AutomationProperties.Name="Previous passage">
            <c:Icon Data="{StaticResource IconSkipBack}" />
          </Button>
          <Button Name="PlayButton" Classes="primary" Command="{Binding PlayPause}" MinWidth="104"
                  ToolTip.Tip="Play or pause (Space). While a passage is being prepared, cancels the start."
                  AutomationProperties.Name="{Binding PlayButtonLabel}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <c:Icon Data="{StaticResource IconPlay}" IsVisible="{Binding PlayButtonShowsPlay}" />
              <c:Icon Data="{StaticResource IconPause}" IsVisible="{Binding PlayButtonShowsPause}" />
              <c:Icon Data="{StaticResource IconClose}" IsVisible="{Binding PlayButtonShowsCancel}" />
              <TextBlock Text="{Binding PlayButtonLabel}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="toolBtn" Command="{Binding Next}" ToolTip.Tip="Next passage (Ctrl+Right)"
                  AutomationProperties.Name="Next passage">
            <c:Icon Data="{StaticResource IconSkipForward}" />
          </Button>

          <Border Classes="toolSep" />

          <ComboBox ItemsSource="{Binding Voices}" SelectedItem="{Binding SelectedVoice}" MinWidth="180"
                    PlaceholderText="Voice" AutomationProperties.Name="Voice"
                    ToolTip.Tip="Voice. Changing it discards prepared audio and re-synthesises from here.">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="domain:TtsVoice">
                <TextBlock Text="{Binding DisplayName}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <ComboBox ItemsSource="{Binding PlaybackRates}" SelectedItem="{Binding PlaybackRate}" MinWidth="80"
                    AutomationProperties.Name="Speed" ToolTip.Tip="Speed (pitch kept)">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="x:Double">
                <TextBlock Text="{Binding StringFormat={}{0}×}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <Border Classes="toolSep" />

          <Button Classes="toolBtn" Classes.active="{Binding IsFollowing}" Command="{Binding ToggleFollow}"
                  ToolTip.Tip="Follow the reading: the view glides with it, line by line (Ctrl+F)"
                  AutomationProperties.Name="Follow the reading">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <c:Icon Data="{StaticResource IconCrosshair}" />
              <TextBlock Text="Follow" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="toolBtn" Command="{Binding ResumeFollow}" IsVisible="{Binding FollowSuspended}"
                  ToolTip.Tip="Browsing paused following; this resumes it. Audio was never stopped. (F9)">
            <TextBlock Text="Resume following" />
          </Button>

          <Border Classes="toolSep" />

          <Button Classes="toolBtn borderless" Command="{Binding NoteOnSentence}"
                  ToolTip.Tip="Pause and write a note on the sentence just read (N; Shift+N for the passage)"
                  AutomationProperties.Name="Note on what was just read">
            <c:Icon Data="{StaticResource IconMessageSquarePlus}" />
          </Button>
          <Button Classes="toolBtn borderless" Command="{Binding HighlightSentence}"
                  ToolTip.Tip="Highlight the sentence just read, without stopping (H; Shift+H for the passage)"
                  AutomationProperties.Name="Highlight what was just read">
            <c:Icon Data="{StaticResource IconHighlighter}" />
          </Button>
          <Button Classes="toolBtn borderless" Classes.active="{Binding AnnotateMode}" Command="{Binding ToggleAnnotateMode}"
                  ToolTip.Tip="Annotate mode: drag over text to mark it, click an annotation to select it (Ctrl+E; Escape leaves)"
                  AutomationProperties.Name="Annotate mode">
            <c:Icon Data="{StaticResource IconPencil}" />
          </Button>
          <StackPanel Orientation="Horizontal" Spacing="2" IsVisible="{Binding AnnotateMode}" VerticalAlignment="Center">
            <Button Classes="toolBtn" Classes.active="{Binding IsHighlightTool}" Command="{Binding ChooseTool}" CommandParameter="Highlight"
                    Content="Highlight" ToolTip.Tip="Drag over text to highlight it" />
            <Button Classes="toolBtn" Classes.active="{Binding IsUnderlineTool}" Command="{Binding ChooseTool}" CommandParameter="Underline"
                    Content="Underline" ToolTip.Tip="Drag over text to underline it" />
            <Button Classes="toolBtn" Classes.active="{Binding IsStrikeOutTool}" Command="{Binding ChooseTool}" CommandParameter="StrikeOut"
                    Content="Strike out" ToolTip.Tip="Drag over text to strike it out" />
            <Button Classes="toolBtn" Classes.active="{Binding IsSquigglyTool}" Command="{Binding ChooseTool}" CommandParameter="Squiggly"
                    Content="Squiggle" ToolTip.Tip="Drag over text to underline it with a wavy line" />
            <Button Classes="toolBtn" Classes.active="{Binding IsTextNoteTool}" Command="{Binding ChooseTool}" CommandParameter="TextNote"
                    Content="Note" ToolTip.Tip="Click anywhere on the page to put a sticky note there" />
            <Button Classes="toolBtn" Classes.active="{Binding IsFreeTextTool}" Command="{Binding ChooseTool}" CommandParameter="FreeText"
                    Content="Text box" ToolTip.Tip="Drag out a box (or click) and write in it on the page" />
            <Button Classes="toolBtn" Classes.active="{Binding IsPenTool}" Command="{Binding ChooseTool}" CommandParameter="Pen"
                    Content="Pen" ToolTip.Tip="Draw freehand on the page" />
            <Button Classes="toolBtn" Classes.active="{Binding IsRectangleTool}" Command="{Binding ChooseTool}" CommandParameter="Rectangle"
                    Content="Box" ToolTip.Tip="Drag out a rectangle round a figure, a table or an equation" />
            <Button Classes="toolBtn" Classes.active="{Binding IsEraserTool}" Command="{Binding ChooseTool}" CommandParameter="Eraser"
                    Content="Eraser" ToolTip.Tip="Click or drag over annotations to remove them (Ctrl+Z brings them back); a stylus's eraser end does the same" />
            <Button Classes="toolBtn" Classes.active="{Binding IsSelectTool}" Command="{Binding ChooseTool}" CommandParameter="None"
                    Content="Select" ToolTip.Tip="Click an annotation to select it, drag a note or text box to move it, double-click to edit; 1–5 recolour, Delete removes" />
            <ItemsControl ItemsSource="{Binding Palette}" VerticalAlignment="Center" Margin="6,0,0,0">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="3" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PaletteColour">
                  <Button Width="22" Height="22" Padding="0" CornerRadius="11" Background="{Binding Brush}"
                          BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                          ToolTip.Tip="{Binding Tip}" AutomationProperties.Name="{Binding Name}"
                          Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).ChooseColour}" CommandParameter="{Binding}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding ActiveColour.Name}" VerticalAlignment="Center" Margin="6,0,0,0" Classes="secondary" />
            <StackPanel Orientation="Horizontal" Spacing="2" IsVisible="{Binding HasThickness}" Margin="8,0,0,0" VerticalAlignment="Center">
              <Button Classes="toolBtn" Classes.active="{Binding IsThin}" Command="{Binding ChooseThickness}" CommandParameter="0"
                      ToolTip.Tip="Thin line" AutomationProperties.Name="Thin line">
                <Border Width="18" Height="1" Background="{DynamicResource SystemControlForegroundBaseHighBrush}" />
              </Button>
              <Button Classes="toolBtn" Classes.active="{Binding IsNormalThickness}" Command="{Binding ChooseThickness}" CommandParameter="1"
                      ToolTip.Tip="Normal line" AutomationProperties.Name="Normal line">
                <Border Width="18" Height="2" Background="{DynamicResource SystemControlForegroundBaseHighBrush}" />
              </Button>
              <Button Classes="toolBtn" Classes.active="{Binding IsThick}" Command="{Binding ChooseThickness}" CommandParameter="2"
                      ToolTip.Tip="Thick line" AutomationProperties.Name="Thick line">
                <Border Width="18" Height="4" Background="{DynamicResource SystemControlForegroundBaseHighBrush}" />
              </Button>
            </StackPanel>
          </StackPanel>

          <Border Classes="toolSep" />

          <c:Icon Data="{StaticResource IconPalette}" VerticalAlignment="Center" Margin="2,0,0,0"
                  ToolTip.Tip="Colour filter for the page" />
          <ComboBox ItemsSource="{Binding ColourEffects}" SelectedItem="{Binding SelectedColourEffect}" MinWidth="150"
                    AutomationProperties.Name="Colour filter"
                    ToolTip.Tip="Colour filter for the page: high contrast, high visibility, amber or invert (C cycles them)">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ColourEffectOption">
                <TextBlock Text="{Binding Name}" ToolTip.Tip="{Binding Description}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <!-- Strength, offered only while a filter is on. -->
          <Slider Width="90" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.25"
                  Value="{Binding ColourEffectIntensity}" IsVisible="{Binding HasColourEffect}"
                  VerticalAlignment="Center" AutomationProperties.Name="Filter strength"
                  ToolTip.Tip="{Binding ColourEffectPercent, StringFormat=Filter strength: {0}%}" />
        </WrapPanel>

        <Button Grid.Column="1" Classes="toolBtn borderless" Command="{Binding OpenSettings}" VerticalAlignment="Center"
                ToolTip.Tip="Settings (Ctrl+,)" AutomationProperties.Name="Settings">
          <c:Icon Data="{StaticResource IconSettings}" />
        </Button>
      </Grid>
    </Border>

    <!-- Status bar, as RailReader2's: what is happening on the left; how far through, the page and
         the zoom on the right. -->
    <Border DockPanel.Dock="Bottom" Padding="8,3" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"
                   IsVisible="{Binding !HasNotice}" ToolTip.Tip="{Binding StatusMessage}" />
        <!-- A notice takes the place of the status, as RailReader2's toasts: amber, with its action. -->
        <!-- Docked, not stacked: the buttons stay put and a long notice is trimmed, not spilled
             over the page and zoom controls. -->
        <DockPanel Grid.Column="0" IsVisible="{Binding HasNotice}" ClipToBounds="True"
                   AutomationProperties.LiveSetting="Polite">
          <Button DockPanel.Dock="Right" Classes="toolBtn borderless" Padding="4" Margin="4,0,0,0" Command="{Binding DismissNotice}"
                  ToolTip.Tip="Dismiss" AutomationProperties.Name="Dismiss notice">
            <c:Icon Data="{StaticResource IconClose}" SizeFactor="0.9" />
          </Button>
          <Button DockPanel.Dock="Right" Classes="toolBtn" Padding="8,2" Margin="10,0,0,0" Command="{Binding NoticeAction}"
                  IsVisible="{Binding Notice.HasAction}" Content="{Binding Notice.ActionLabel}" />
          <TextBlock Text="{Binding Notice.Text}" Foreground="{DynamicResource WarningTextBrush}" FontWeight="SemiBold"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Notice.Text}" />
        </DockPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="12,0,0,0">
          <TextBlock Text="{Binding CurrentSection}" IsVisible="{Binding HasCurrentSection}" VerticalAlignment="Center"
                     MaxWidth="320" TextTrimming="CharacterEllipsis" Classes="secondary"
                     ToolTip.Tip="{Binding CurrentSectionPath}" />
          <Border Classes="toolSep" IsVisible="{Binding HasCurrentSection}" />
          <ProgressBar Width="120" Minimum="0" Maximum="1" Value="{Binding Playback.PlanProgress}" VerticalAlignment="Center"
                       ToolTip.Tip="How far through the document" AutomationProperties.Name="How far through the document" />
          <Border Classes="toolSep" />
          <StackPanel Orientation="Horizontal" Spacing="4" IsEnabled="{Binding HasDocument}">
          <Button Classes="toolBtn borderless" Click="OnPreviousPageClicked" ToolTip.Tip="Previous page (Page Up). Pauses following."
                  AutomationProperties.Name="Previous page">
            <c:Icon Data="{StaticResource IconChevronLeft}" />
          </Button>
          <TextBlock Name="PageLabel" Text="Page –" VerticalAlignment="Center" MinWidth="76" TextAlignment="Center" />
          <Button Classes="toolBtn borderless" Click="OnNextPageClicked" ToolTip.Tip="Next page (Page Down). Pauses following."
                  AutomationProperties.Name="Next page">
            <c:Icon Data="{StaticResource IconChevronRight}" />
          </Button>
          <Border Classes="toolSep" />
          <Button Classes="toolBtn borderless" Command="{Binding ZoomOut}" ToolTip.Tip="Zoom out (Ctrl+-, or Ctrl+wheel)"
                  AutomationProperties.Name="Zoom out">
            <c:Icon Data="{StaticResource IconMinus}" />
          </Button>
          <TextBlock Text="{Binding ZoomPercent, StringFormat={}{0}%}" VerticalAlignment="Center" MinWidth="48"
                     TextAlignment="Center" />
          <Button Classes="toolBtn borderless" Command="{Binding ZoomIn}" ToolTip.Tip="Zoom in (Ctrl++)"
                  AutomationProperties.Name="Zoom in">
            <c:Icon Data="{StaticResource IconPlus}" />
          </Button>
          <ToggleButton Classes="toolBtn borderless" IsChecked="{Binding FitWidth, Mode=TwoWay}"
                        ToolTip.Tip="Fit the page's width, and keep it fitted through page turns and resizes"
                        AutomationProperties.Name="Fit width">
            <c:Icon Data="{StaticResource IconMoveHorizontal}" />
          </ToggleButton>
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Content: the sidebar on the left, as RailReader2's (accordion sections, one open at a time,
         width dragged and remembered), and the reading area. Shown, hidden and sized in code-behind. -->
    <Grid Name="ContentGrid" ColumnDefinitions="300,Auto,*">
      <Border Name="Sidebar" Grid.Column="0" Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
              AutomationProperties.Name="Sidebar">
        <Grid Name="Accordion" RowDefinitions="*,Auto,Auto,Auto,Auto">
          <Expander Grid.Row="0" Name="OutlineSection" Classes="accordion" Header="Outline">
            <Panel>
              <TreeView Name="OutlineTree" ItemsSource="{Binding Outline}" IsVisible="{Binding HasOutline}"
                        SelectionChanged="OnOutlineSelectionChanged" AutomationProperties.Name="Outline">
                <TreeView.ItemTemplate>
                  <TreeDataTemplate ItemsSource="{Binding Children}" x:DataType="vm:OutlineItem">
                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding PageLabel}" />
                  </TreeDataTemplate>
                </TreeView.ItemTemplate>
              </TreeView>
              <TextBlock IsVisible="{Binding !HasOutline}" Classes="secondary" TextWrapping="Wrap" Margin="8"
                         Text="This document has no outline of its own. The script lists every passage; click one to read from there." />
            </Panel>
          </Expander>
          <Expander Grid.Row="1" Name="ScriptSection" Classes="accordion" Header="Script">
              <ListBox Name="TranscriptList" ItemsSource="{Binding Transcript}" AutomationProperties.Name="Script"
                       SelectedIndex="{Binding SelectedTranscriptIndex}"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:TranscriptEntry">
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Left" Margin="0,0,4,0" Text="∑" Foreground="{DynamicResource WarningTextBrush}" IsVisible="{Binding IsMaths}"
                                 ToolTip.Tip="Mathematical passage" />
                      <TextBlock DockPanel.Dock="Left" Margin="0,0,4,0" Text="!" Foreground="{DynamicResource WarningTextBrush}" IsVisible="{Binding HasWarning}"
                                 ToolTip.Tip="This passage has a warning; see Maths review" />
                      <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                    </DockPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
          </Expander>
          <Expander Grid.Row="2" Name="MathsSection" Classes="accordion" Header="Maths review">
            <Panel>
              <TextBlock IsVisible="{Binding MathsReview, Converter={x:Static ObjectConverters.IsNull}}" Classes="secondary"
                         TextWrapping="Wrap" Margin="8"
                         Text="Choose a passage with maths in the script (marked ∑) to see what was recognised and what is said, and to correct it." />
              <ScrollViewer IsVisible="{Binding MathsReview, Converter={x:Static ObjectConverters.IsNotNull}}">
                <StackPanel Spacing="4" DataContext="{Binding MathsReview}" x:DataType="vm:MathsReview">
                  <TextBlock Text="Recognised expression:" FontSize="11" Opacity="0.75" />
                  <TextBox Name="MathsExpressionBox" Text="{Binding RecognisedExpression}" IsReadOnly="True"
                           FontFamily="monospace" TextWrapping="Wrap" MaxHeight="60" />
                  <TextBlock Text="Spoken version:" FontSize="11" Opacity="0.75" />
                  <TextBox Name="MathsEditBox" Text="{Binding SpokenVersion, Mode=OneWay}" AcceptsReturn="True"
                           TextWrapping="Wrap" MinHeight="60" MaxHeight="120"
                           PlaceholderText="Correct the spoken text; the previous audio for it is discarded" />
                  <TextBlock Text="{Binding Provenance, StringFormat=Source: {0}}" FontSize="11" Opacity="0.75" />
                  <ItemsControl ItemsSource="{Binding Warnings}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{Binding}" FontSize="11" Foreground="{DynamicResource WarningTextBrush}" TextWrapping="Wrap" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Content="Use my text" Click="OnMathsEditClicked" />
                    <Button Content="Regenerate" Click="OnMathsRegenerateClicked" IsEnabled="{Binding CanRegenerate}" />
                  </StackPanel>
                </StackPanel>
              </ScrollViewer>
            </Panel>
          </Expander>
          <Expander Grid.Row="3" Name="ReviewSection" Classes="accordion" Header="Review notes">
            <Panel>
              <TextBlock IsVisible="{Binding !HasReviewNotes}" TextWrapping="Wrap" Classes="secondary" Margin="4"
                         Text="No notes yet. While listening, press N to pause and write a note on the sentence just read, or H to highlight it." />
              <ListBox Name="ReviewNotesList" ItemsSource="{Binding ReviewNotes}" IsVisible="{Binding HasReviewNotes}"
                       SelectionChanged="OnReviewNoteSelectionChanged" AutomationProperties.Name="Review notes">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:ReviewNoteItem">
                    <Grid ColumnDefinitions="Auto,*" AutomationProperties.Name="{Binding Description}">
                      <Border Grid.Column="0" Width="6" CornerRadius="3" Margin="0,2,8,2" Background="{Binding Swatch}" />
                      <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="{Binding PageLabel}" Classes="secondary" FontSize="11" />
                        <TextBlock Text="{Binding Note}" IsVisible="{Binding HasNote}" TextWrapping="Wrap" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Quote}" IsVisible="{Binding HasQuote}" TextWrapping="Wrap" MaxLines="3"
                                   TextTrimming="CharacterEllipsis" FontStyle="Italic" Opacity="0.85" FontSize="12" />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                          <Button Content="Edit note" Classes="borderless" FontSize="11" Padding="4,1"
                                  Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).EditReviewNote}" CommandParameter="{Binding}" />
                          <Button Content="Delete" Classes="borderless" FontSize="11" Padding="4,1"
                                  Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).DeleteReviewNote}" CommandParameter="{Binding}" />
                        </StackPanel>
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Panel>
          </Expander>
          <Expander Grid.Row="4" Name="NotesSection" Classes="accordion" Header="Diagnostics">
            <ScrollViewer>
              <StackPanel Spacing="4">
                <TextBlock Text="{Binding SpeechProviderSummary, StringFormat=Speech providers: {0}}" FontSize="11" />
                <TextBlock Text="{Binding LayoutSummary, StringFormat=Layout analysis: {0}}" FontSize="11" TextWrapping="Wrap" />
                <TextBlock Text="{Binding TimingSummary}" FontSize="11" TextWrapping="Wrap" />
                <TextBlock Text="{Binding MathEndpointSummary, StringFormat=Text LLM: {0}}" FontSize="11" TextWrapping="Wrap" />
                <TextBlock Text="{Binding VisionEndpointSummary, StringFormat=Vision: {0}}" FontSize="11" TextWrapping="Wrap" />
                <TextBlock Text="{Binding FormulaModelSummary, StringFormat=Formula model: {0}}" FontSize="11" TextWrapping="Wrap" />
                <TextBlock Text="{Binding CacheBytes, StringFormat=Speech cache: {0} bytes}" FontSize="11" />
                <ItemsControl ItemsSource="{Binding Notes}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <TextBlock Text="{Binding}" FontSize="11" TextWrapping="Wrap" Opacity="0.85" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </Expander>
        </Grid>
      </Border>
      <GridSplitter Name="SidebarSplitter" Grid.Column="1" Width="5" ResizeDirection="Columns"
                    Background="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    AutomationProperties.Name="Sidebar width" />

    <!-- Reading area. The first card over it appears only while a start is waiting for audio: what
         is being prepared and for how long, where the reader is looking, not only in the status bar.
         It does not take input, so the page can still be browsed or clicked underneath. -->
    <Panel Grid.Column="2">
      <views:PdfSurface Name="Surface" Focusable="True" />

      <!-- Nothing open: the welcome screen, as RailReader2's. The mark, how to open a document, the
           documents read before (with how far through), and the keys that matter most. -->
      <ScrollViewer Name="Welcome" IsVisible="{Binding !HasDocument}"
                    Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
        <StackPanel MaxWidth="780" HorizontalAlignment="Center" Margin="24,40,24,32" Spacing="8">
          <!-- On white in both themes, as RailReader2's logo, so the black mark stays visible. -->
          <Border Background="White" CornerRadius="12" Padding="6" HorizontalAlignment="Center">
            <Image Source="avares://rail-narrator/Assets/rail-narrator.png" Width="150" Height="150" />
          </Border>
          <TextBlock Text="Rail Narrator" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <TextBlock Text="Reads a PDF aloud and highlights each passage in the page as it is read"
                     Classes="secondary" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
          <Button Classes="primary" Content="Open a PDF…" Click="OnOpenClicked" HorizontalAlignment="Center"
                  Padding="22,8" Margin="0,14,0,0" />
          <TextBlock Text="or press Ctrl+O, or drop a PDF on this window" Classes="secondary" HorizontalAlignment="Center" />

          <StackPanel IsVisible="{Binding HasRecentDocuments}" Spacing="10" Margin="0,28,0,0">
            <TextBlock Text="Recent documents" FontWeight="Bold" />
            <ItemsControl ItemsSource="{Binding RecentDocuments}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel ItemSpacing="12" LineSpacing="12" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:RecentDocumentView">
                  <Button Classes="toolBtn" Width="176" Padding="8" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top"
                          Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).OpenRecent}" CommandParameter="{Binding}"
                          Classes.missing="{Binding !Exists}" ToolTip.Tip="{Binding Path}" AutomationProperties.Name="{Binding Name}">
                    <!-- A missing document stays enabled (dimmed): a disabled button takes no right-click,
                         so it could never be removed. The items are handled in code-behind, as a binding
                         to the window's view model does not resolve from the menu's popup. -->
                    <Button.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="_Open" Click="OnRecentOpenClicked" IsEnabled="{Binding Exists}" />
                        <MenuItem Header="_Remove from recent documents" Click="OnRecentRemoveClicked" />
                        <Separator />
                        <MenuItem Header="Remove _missing documents" Click="OnRecentRemoveMissingClicked" />
                        <MenuItem Header="_Clear recent documents" Click="OnRecentClearClicked" />
                      </ContextMenu>
                    </Button.ContextMenu>
                    <StackPanel Spacing="6">
                      <Border Height="200" Background="White" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1">
                        <Panel>
                          <Image Source="{Binding Thumbnail}" Stretch="Uniform" VerticalAlignment="Top" IsVisible="{Binding HasThumbnail}" />
                          <c:Icon Data="{StaticResource IconFolderOpen}" SizeFactor="2.4" Foreground="#909090"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasThumbnail}" />
                        </Panel>
                      </Border>
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="1" Height="3" MinHeight="3" IsVisible="{Binding HasProgress}" />
                      <TextBlock Text="{Binding Detail}" Classes="secondary" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <Border Height="1" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" Margin="0,24,0,8" />
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="6"
                HorizontalAlignment="Center">
            <TextBlock Grid.Row="0" Text="Space" FontWeight="SemiBold" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="Play or pause" />
            <TextBlock Grid.Row="1" Text="Ctrl+← →" FontWeight="SemiBold" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="Previous or next passage; click a passage to read from it" />
            <TextBlock Grid.Row="2" Text="F6" FontWeight="SemiBold" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="Sidebar: the outline, the script and maths review" />
            <TextBlock Grid.Row="3" Text="N  ·  H" FontWeight="SemiBold" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="Pause and note the sentence just read · highlight it" />
            <TextBlock Grid.Row="4" Text="C" FontWeight="SemiBold" />
            <TextBlock Grid.Row="4" Grid.Column="1" Text="Cycle colour filters for comfort" />
            <TextBlock Grid.Row="5" Text="F1" FontWeight="SemiBold" />
            <TextBlock Grid.Row="5" Grid.Column="1" Text="Every keyboard shortcut" />
          </Grid>
        </StackPanel>
      </ScrollViewer>
      <!-- The note card: written while paused, beside the text it is on (outlined on the page). Enter
           saves and stays paused, Ctrl+Enter saves and reads on, Shift+Enter starts a new line,
           Escape gives up. Placed in code-behind. -->
      <Border Name="NoteCard" IsVisible="{Binding IsNoteEditorOpen}" Classes="overlayCard" BorderThickness="1"
              HorizontalAlignment="Left" VerticalAlignment="Top" Width="400" Padding="14,12" CornerRadius="8">
        <StackPanel Spacing="8">
          <TextBlock Text="{Binding NoteEditorTitle}" FontWeight="SemiBold" />
          <TextBlock Text="{Binding NoteEditorQuote}" FontStyle="Italic" Opacity="0.85" FontSize="12"
                     TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" />
          <TextBox Name="NoteEditorBox" Text="{Binding NoteEditorText, Mode=TwoWay}" AcceptsReturn="True"
                   TextWrapping="Wrap" MinHeight="72" MaxHeight="220" PlaceholderText="Your note"
                   AutomationProperties.Name="Note" />
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Classes="secondary" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"
                       Text="Enter saves · Ctrl+Enter saves and reads on · Esc cancels" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
              <Button Content="Cancel" Command="{Binding CancelNote}" />
              <Button Content="Save" Classes="primary" Command="{Binding SaveNote}" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>

      <Border IsVisible="{Binding IsPreparing}" IsHitTestVisible="False"
              HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,16,0,0"
              Padding="16,10" CornerRadius="8" MinWidth="320"
              Classes="overlayCard" BorderThickness="1">
        <StackPanel Spacing="8">
          <TextBlock Text="{Binding PreparationText}" FontSize="14"
                     TextAlignment="Center" TextWrapping="Wrap" />
          <!-- Indeterminate only while shown: a hidden indeterminate bar still animates, and on X11
               that kept a core busy (RailReader2's finding). -->
          <ProgressBar IsIndeterminate="{Binding IsPreparing}" Height="4" MinWidth="280" />
          <TextBlock Text="Not playing yet: reading starts as soon as the audio is ready."
                     Classes="secondary" FontSize="11" TextAlignment="Center" />
        </StackPanel>
      </Border>

      <!-- Opening a document. A veil over whatever was on screen (the previous document, or nothing)
           and a card in the middle of the reading area saying which file is being opened, what is
           being done to it and how far that has got. The veil takes the pointer, so a click cannot
           start the previous document reading underneath. The stage is a live region, so a screen
           reader announces each change. -->
      <!-- While a PDF is dragged over the window: where it will go. Takes no input. -->
      <Border Name="DropHint" IsVisible="False" IsHitTestVisible="False" Margin="24"
              Background="{DynamicResource OverlayVeilBrush}" CornerRadius="12"
              BorderBrush="{DynamicResource SystemControlHighlightAccentBrush}" BorderThickness="3">
        <Border Classes="overlayCard" BorderThickness="2" CornerRadius="12" Padding="28,20"
                HorizontalAlignment="Center" VerticalAlignment="Center">
          <StackPanel Spacing="10" HorizontalAlignment="Center">
            <c:Icon Data="{StaticResource IconFolderOpen}" SizeFactor="3" HorizontalAlignment="Center" />
            <TextBlock Name="DropHintText" FontSize="18" FontWeight="SemiBold" TextAlignment="Center" />
          </StackPanel>
        </Border>
      </Border>

      <Border Name="LoadingVeil" IsVisible="{Binding IsLoading}" Background="{DynamicResource OverlayVeilBrush}">
        <Border Name="LoadingCard" HorizontalAlignment="Center" VerticalAlignment="Center"
                Padding="32,26" CornerRadius="12" MinWidth="460" MaxWidth="640" Margin="24"
                Classes="overlayCard" BorderThickness="2">
          <StackPanel Spacing="12">
            <TextBlock Text="OPENING DOCUMENT" Classes="eyebrow" />
            <TextBlock Text="{Binding LoadingTitle}" FontSize="22" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap" />
            <TextBlock Name="LoadingStageText" Text="{Binding LoadingStage}" FontSize="17"
                       TextWrapping="Wrap" Margin="0,8,0,0"
                       AutomationProperties.LiveSetting="Polite" />
            <ProgressBar Name="LoadingBar" Height="10" MinWidth="400" CornerRadius="5"
                         Minimum="0" Maximum="1" Value="{Binding LoadingProgress}"
                         IsIndeterminate="{Binding LoadingIndeterminate}" />
            <TextBlock Text="{Binding LoadingDetail}" Classes="secondary" FontSize="14" MinHeight="20" />
            <TextBlock Text="The pages are analysed once and remembered: this document opens faster next time."
                       Classes="secondary" FontSize="12" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </Border>
    </Panel>
    </Grid>
  </DockPanel>
</Window>
