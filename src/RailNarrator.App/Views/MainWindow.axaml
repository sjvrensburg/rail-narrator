<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RailNarrator.App.ViewModels"
        xmlns:domain="using:RailNarrator.Domain"
        xmlns:views="using:RailNarrator.App.Views"
        xmlns:c="using:RailNarrator.App.Controls"
        x:Class="RailNarrator.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Rail Narrator"
        Width="1440" Height="900"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen">

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenDocument}" />
    <KeyBinding Gesture="Ctrl+OemComma" Command="{Binding OpenSettings}" />
    <!-- Space and Escape are handled in MainWindow.OnPreviewKeyDown, not here: a window-level
         binding also fires while a text box is being typed in or a menu is being dismissed. -->
    <KeyBinding Gesture="Ctrl+P" Command="{Binding PlayPause}" />
    <KeyBinding Gesture="Ctrl+Right" Command="{Binding Next}" />
    <KeyBinding Gesture="Ctrl+Left" Command="{Binding Previous}" />
    <KeyBinding Gesture="Ctrl+R" Command="{Binding Replay}" />
    <KeyBinding Gesture="Ctrl+OemPlus" Command="{Binding ZoomIn}" />
    <KeyBinding Gesture="Ctrl+OemMinus" Command="{Binding ZoomOut}" />
    <KeyBinding Gesture="Ctrl+F" Command="{Binding ToggleFollow}" />
    <KeyBinding Gesture="F9" Command="{Binding ResumeFollow}" />
    <KeyBinding Gesture="F6" Command="{Binding ToggleSidebar}" />
  </Window.KeyBindings>

  <Window.Styles>
    <!-- RailReader2's accordion: full-width headers, the open section's content fills its row. -->
    <Style Selector="Expander.accordion">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Margin" Value="0,0,0,1" />
    </Style>
  </Window.Styles>

  <DockPanel>

    <!-- Menu: every command reachable without a pointer -->
    <Menu Name="MainMenu" DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="_Open PDF…" Click="OnOpenClicked" InputGesture="Ctrl+O" />
        <MenuItem Header="_Settings…" Command="{Binding OpenSettings}" InputGesture="Ctrl+OemComma" />
        <Separator />
        <MenuItem Header="E_xit" Click="OnCloseClicked" />
      </MenuItem>
      <MenuItem Header="_Playback">
        <MenuItem Header="_Play / pause" Command="{Binding PlayPause}" InputGesture="Space" />
        <Separator />
        <MenuItem Header="_Previous passage" Command="{Binding Previous}" InputGesture="Ctrl+Left" />
        <MenuItem Header="_Next passage" Command="{Binding Next}" InputGesture="Ctrl+Right" />
        <MenuItem Header="_Replay passage" Command="{Binding Replay}" InputGesture="Ctrl+R" />
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="Zoom _in" Command="{Binding ZoomIn}" InputGesture="Ctrl+OemPlus" />
        <MenuItem Header="Zoom _out" Command="{Binding ZoomOut}" InputGesture="Ctrl+OemMinus" />
        <MenuItem Header="_Fit width" ToggleType="CheckBox" IsChecked="{Binding FitWidth, Mode=TwoWay}" />
        <MenuItem Header="Zoom 200%" Command="{Binding Zoom200}" />
        <MenuItem Header="Zoom 400%" Command="{Binding Zoom400}" />
        <MenuItem Header="Zoom 800%" Command="{Binding Zoom800}" />
        <Separator />
        <MenuItem Header="_Follow the reading" Command="{Binding ToggleFollow}" InputGesture="Ctrl+F" />
        <MenuItem Header="_Resume following" Command="{Binding ResumeFollow}" InputGesture="F9" />
        <Separator />
        <MenuItem Header="{Binding ColourFilterMenuHeader}">
          <MenuItem Header="_Next colour filter" Click="OnCycleColourFilterClicked" InputGesture="C" />
          <Separator />
          <MenuItem Header="_None" Tag="None" Click="OnColourFilterClicked" />
          <MenuItem Header="_High contrast (white on black)" Tag="HighContrast" Click="OnColourFilterClicked" />
          <MenuItem Header="High _visibility (yellow on black)" Tag="HighVisibility" Click="OnColourFilterClicked" />
          <MenuItem Header="_Amber" Tag="Amber" Click="OnColourFilterClicked" />
          <MenuItem Header="_Invert" Tag="Invert" Click="OnColourFilterClicked" />
        </MenuItem>
        <Separator />
        <MenuItem Header="_Sidebar: outline, script, maths review, notes" ToggleType="CheckBox"
                  IsChecked="{Binding SidebarVisible, Mode=TwoWay}" InputGesture="F6" />
      </MenuItem>
      <MenuItem Header="_Maths">
        <MenuItem Header="Mark region as _maths" Click="OnMarkAsMathsClicked" />
        <MenuItem Header="Restore region as _prose" Click="OnRestoreAsProseClicked" />
        <MenuItem Header="_Regenerate narration" Command="{Binding RegenerateMaths}" />
      </MenuItem>
      <MenuItem Header="_Models and endpoints">
        <MenuItem Header="Download _Kokoro model…" Command="{Binding DownloadKokoroModel}" />
        <MenuItem Header="Download _layout model (Docling Heron INT8, 69 MB)…" Command="{Binding DownloadLayoutModel}" />
        <MenuItem Header="Download layout model for the _GPU (Docling Heron FP32, 171 MB)…" Command="{Binding DownloadLayoutModelGpu}" />
        <MenuItem Header="_Endpoints and API keys…" Command="{Binding OpenSettings}" />
        <MenuItem Header="_Test text LLM endpoint" Command="{Binding TestMathEndpoint}" />
        <MenuItem Header="Test _vision endpoint" Command="{Binding TestVisionEndpoint}" />
      </MenuItem>
    </Menu>

    <!-- Toolbar: what a listener reaches for. Transport, voice and speed; following and the
         colour filter; settings at the far end. Page and zoom are in the status bar, as in
         RailReader2. Icon buttons carry their name for screen readers and their shortcut in the
         tooltip. -->
    <Border DockPanel.Dock="Top" Padding="8,6" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto">
        <!-- Wraps rather than clipping, so nothing becomes unreachable in a narrow window. -->
        <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="4" VerticalAlignment="Center">
          <ToggleButton Classes="toolBtn borderless" IsChecked="{Binding SidebarVisible, Mode=TwoWay}"
                        ToolTip.Tip="Sidebar: outline, script, maths review and notes (F6)"
                        AutomationProperties.Name="Sidebar">
            <c:Icon Data="{StaticResource IconPanelLeft}" />
          </ToggleButton>
          <!-- The open document, as RailReader2's tab (one document at a time here). -->
          <Border IsVisible="{Binding HasDocument}" Padding="10,4" CornerRadius="5,5,0,0" VerticalAlignment="Stretch"
                  Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                  BorderBrush="{DynamicResource SystemControlHighlightAccentBrush}" BorderThickness="0,2,0,0"
                  ToolTip.Tip="{Binding DocumentPath}">
            <TextBlock Text="{Binding DocumentName}" FontWeight="SemiBold" VerticalAlignment="Center"
                       MaxWidth="260" TextTrimming="CharacterEllipsis" />
          </Border>

          <Border Classes="toolSep" />

          <Button Classes="toolBtn" Command="{Binding Previous}" ToolTip.Tip="Previous passage (Ctrl+Left)"
                  AutomationProperties.Name="Previous passage">
            <c:Icon Data="{StaticResource IconSkipBack}" />
          </Button>
          <Button Name="PlayButton" Classes="primary" Command="{Binding PlayPause}" MinWidth="104"
                  ToolTip.Tip="Play or pause (Space). While a passage is being prepared, cancels the start."
                  AutomationProperties.Name="{Binding PlayButtonLabel}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <c:Icon Data="{StaticResource IconPlay}" IsVisible="{Binding PlayButtonShowsPlay}" />
              <c:Icon Data="{StaticResource IconPause}" IsVisible="{Binding PlayButtonShowsPause}" />
              <c:Icon Data="{StaticResource IconClose}" IsVisible="{Binding PlayButtonShowsCancel}" />
              <TextBlock Text="{Binding PlayButtonLabel}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="toolBtn" Command="{Binding Next}" ToolTip.Tip="Next passage (Ctrl+Right)"
                  AutomationProperties.Name="Next passage">
            <c:Icon Data="{StaticResource IconSkipForward}" />
          </Button>

          <Border Classes="toolSep" />

          <ComboBox ItemsSource="{Binding Voices}" SelectedItem="{Binding SelectedVoice}" MinWidth="180"
                    PlaceholderText="Voice" AutomationProperties.Name="Voice"
                    ToolTip.Tip="Voice. Changing it discards prepared audio and re-synthesises from here.">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="domain:TtsVoice">
                <TextBlock Text="{Binding DisplayName}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <ComboBox ItemsSource="{Binding PlaybackRates}" SelectedItem="{Binding PlaybackRate}" MinWidth="80"
                    AutomationProperties.Name="Speed" ToolTip.Tip="Speed (pitch kept)">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="x:Double">
                <TextBlock Text="{Binding StringFormat={}{0}×}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <Border Classes="toolSep" />

          <Button Classes="toolBtn" Classes.active="{Binding IsFollowing}" Command="{Binding ToggleFollow}"
                  ToolTip.Tip="Follow the reading: the view glides with it, line by line (Ctrl+F)"
                  AutomationProperties.Name="Follow the reading">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <c:Icon Data="{StaticResource IconCrosshair}" />
              <TextBlock Text="Follow" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="toolBtn" Command="{Binding ResumeFollow}" IsVisible="{Binding FollowSuspended}"
                  ToolTip.Tip="Browsing paused following; this resumes it. Audio was never stopped. (F9)">
            <TextBlock Text="Resume following" />
          </Button>

          <Border Classes="toolSep" />

          <c:Icon Data="{StaticResource IconPalette}" VerticalAlignment="Center" Margin="2,0,0,0"
                  ToolTip.Tip="Colour filter for the page" />
          <ComboBox ItemsSource="{Binding ColourEffects}" SelectedItem="{Binding SelectedColourEffect}" MinWidth="150"
                    AutomationProperties.Name="Colour filter"
                    ToolTip.Tip="Colour filter for the page: high contrast, high visibility, amber or invert (C cycles them)">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ColourEffectOption">
                <TextBlock Text="{Binding Name}" ToolTip.Tip="{Binding Description}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <!-- Strength, offered only while a filter is on. -->
          <Slider Width="90" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.25"
                  Value="{Binding ColourEffectIntensity}" IsVisible="{Binding HasColourEffect}"
                  VerticalAlignment="Center" AutomationProperties.Name="Filter strength"
                  ToolTip.Tip="{Binding ColourEffectPercent, StringFormat=Filter strength: {0}%}" />
        </WrapPanel>

        <Button Grid.Column="1" Classes="toolBtn borderless" Command="{Binding OpenSettings}" VerticalAlignment="Center"
                ToolTip.Tip="Settings (Ctrl+,)" AutomationProperties.Name="Settings">
          <c:Icon Data="{StaticResource IconSettings}" />
        </Button>
      </Grid>
    </Border>

    <!-- Status bar, as RailReader2's: what is happening on the left; how far through, the page and
         the zoom on the right. -->
    <Border DockPanel.Dock="Bottom" Padding="8,3" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"
                   IsVisible="{Binding !HasNotice}" ToolTip.Tip="{Binding StatusMessage}" />
        <!-- A notice takes the place of the status, as RailReader2's toasts: amber, with its action. -->
        <!-- Docked, not stacked: the buttons stay put and a long notice is trimmed, not spilled
             over the page and zoom controls. -->
        <DockPanel Grid.Column="0" IsVisible="{Binding HasNotice}" ClipToBounds="True"
                   AutomationProperties.LiveSetting="Polite">
          <Button DockPanel.Dock="Right" Classes="toolBtn borderless" Padding="4" Margin="4,0,0,0" Command="{Binding DismissNotice}"
                  ToolTip.Tip="Dismiss" AutomationProperties.Name="Dismiss notice">
            <c:Icon Data="{StaticResource IconClose}" SizeFactor="0.9" />
          </Button>
          <Button DockPanel.Dock="Right" Classes="toolBtn" Padding="8,2" Margin="10,0,0,0" Command="{Binding NoticeAction}"
                  IsVisible="{Binding Notice.HasAction}" Content="{Binding Notice.ActionLabel}" />
          <TextBlock Text="{Binding Notice.Text}" Foreground="#C07800" FontWeight="SemiBold"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Notice.Text}" />
        </DockPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="12,0,0,0">
          <TextBlock Text="{Binding CurrentSection}" IsVisible="{Binding HasCurrentSection}" VerticalAlignment="Center"
                     MaxWidth="320" TextTrimming="CharacterEllipsis" Classes="secondary"
                     ToolTip.Tip="{Binding CurrentSectionPath}" />
          <Border Classes="toolSep" IsVisible="{Binding HasCurrentSection}" />
          <ProgressBar Width="120" Minimum="0" Maximum="1" Value="{Binding Playback.PlanProgress}" VerticalAlignment="Center"
                       ToolTip.Tip="How far through the document" AutomationProperties.Name="How far through the document" />
          <Border Classes="toolSep" />
          <Button Classes="toolBtn borderless" Click="OnPreviousPageClicked" ToolTip.Tip="Previous page (Page Up). Pauses following."
                  AutomationProperties.Name="Previous page">
            <c:Icon Data="{StaticResource IconChevronLeft}" />
          </Button>
          <TextBlock Name="PageLabel" Text="Page –" VerticalAlignment="Center" MinWidth="76" TextAlignment="Center" />
          <Button Classes="toolBtn borderless" Click="OnNextPageClicked" ToolTip.Tip="Next page (Page Down). Pauses following."
                  AutomationProperties.Name="Next page">
            <c:Icon Data="{StaticResource IconChevronRight}" />
          </Button>
          <Border Classes="toolSep" />
          <Button Classes="toolBtn borderless" Command="{Binding ZoomOut}" ToolTip.Tip="Zoom out (Ctrl+-, or Ctrl+wheel)"
                  AutomationProperties.Name="Zoom out">
            <c:Icon Data="{StaticResource IconMinus}" />
          </Button>
          <TextBlock Text="{Binding ZoomPercent, StringFormat={}{0}%}" VerticalAlignment="Center" MinWidth="48"
                     TextAlignment="Center" />
          <Button Classes="toolBtn borderless" Command="{Binding ZoomIn}" ToolTip.Tip="Zoom in (Ctrl++)"
                  AutomationProperties.Name="Zoom in">
            <c:Icon Data="{StaticResource IconPlus}" />
          </Button>
          <ToggleButton Classes="toolBtn borderless" IsChecked="{Binding FitWidth, Mode=TwoWay}"
                        ToolTip.Tip="Fit the page's width, and keep it fitted through page turns and resizes"
                        AutomationProperties.Name="Fit width">
            <c:Icon Data="{StaticResource IconMoveHorizontal}" />
          </ToggleButton>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Content: the sidebar on the left, as RailReader2's (accordion sections, one open at a time,
         width dragged and remembered), and the reading area. Shown, hidden and sized in code-behind. -->
    <Grid Name="ContentGrid" ColumnDefinitions="300,Auto,*">
      <Border Name="Sidebar" Grid.Column="0" Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
              AutomationProperties.Name="Sidebar">
        <Grid Name="Accordion" RowDefinitions="*,Auto,Auto,Auto">
          <Expander Grid.Row="0" Name="OutlineSection" Classes="accordion" Header="Outline">
            <Panel>
              <TreeView Name="OutlineTree" ItemsSource="{Binding Outline}" IsVisible="{Binding HasOutline}"
                        SelectionChanged="OnOutlineSelectionChanged" AutomationProperties.Name="Outline">
                <TreeView.ItemTemplate>
                  <TreeDataTemplate ItemsSource="{Binding Children}" x:DataType="vm:OutlineItem">
                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding PageLabel}" />
                  </TreeDataTemplate>
                </TreeView.ItemTemplate>
              </TreeView>
              <TextBlock IsVisible="{Binding !HasOutline}" Classes="secondary" TextWrapping="Wrap" Margin="8"
                         Text="This document has no outline of its own. The script lists every passage; click one to read from there." />
            </Panel>
          </Expander>
          <Expander Grid.Row="1" Name="ScriptSection" Classes="accordion" Header="Script">
              <ListBox Name="TranscriptList" ItemsSource="{Binding Transcript}"
                       SelectedIndex="{Binding SelectedTranscriptIndex}"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:TranscriptEntry">
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Left" Margin="0,0,4,0" Text="∑" Foreground="#C07800" IsVisible="{Binding IsMaths}"
                                 ToolTip.Tip="Mathematical passage" />
                      <TextBlock DockPanel.Dock="Left" Margin="0,0,4,0" Text="!" Foreground="#C07800" IsVisible="{Binding HasWarning}"
                                 ToolTip.Tip="This passage has a warning; see Maths review" />
                      <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                    </DockPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
          </Expander>
          <Expander Grid.Row="2" Name="MathsSection" Classes="accordion" Header="Maths review">
            <Panel>
              <TextBlock IsVisible="{Binding MathsReview, Converter={x:Static ObjectConverters.IsNull}}" Classes="secondary"
                         TextWrapping="Wrap" Margin="8"
                         Text="Choose a passage with maths in the script (marked ∑) to see what was recognised and what is said, and to correct it." />
              <ScrollViewer IsVisible="{Binding MathsReview, Converter={x:Static ObjectConverters.IsNotNull}}">
                <StackPanel Spacing="4" DataContext="{Binding MathsReview}" x:DataType="vm:MathsReview">
                  <TextBlock Text="Recognised expression:" FontSize="11" Opacity="0.75" />
                  <TextBox Name="MathsExpressionBox" Text="{Binding RecognisedExpression}" IsReadOnly="True"
                           FontFamily="monospace" TextWrapping="Wrap" MaxHeight="60" />
                  <TextBlock Text="Spoken version:" FontSize="11" Opacity="0.75" />
                  <TextBox Name="MathsEditBox" Text="{Binding SpokenVersion}" AcceptsReturn="True"
                           TextWrapping="Wrap" MinHeight="60" MaxHeight="120"
                           PlaceholderText="Correct the spoken text; the previous audio for it is discarded" />
                  <TextBlock Text="{Binding Provenance, StringFormat=Source: {0}}" FontSize="11" Opacity="0.75" />
                  <ItemsControl ItemsSource="{Binding Warnings}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{Binding}" FontSize="11" Foreground="#C07800" TextWrapping="Wrap" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Content="Use my text" Click="OnMathsEditClicked" />
                    <Button Content="Regenerate" Click="OnMathsRegenerateClicked" IsEnabled="{Binding CanRegenerate}" />
                  </StackPanel>
                </StackPanel>
              </ScrollViewer>
            </Panel>
          </Expander>
          <Expander Grid.Row="3" Name="NotesSection" Classes="accordion" Header="Notes and diagnostics">
            <ScrollViewer>
              <StackPanel Spacing="4">
                <TextBlock Text="{Binding SpeechProviderSummary, StringFormat=Speech providers: {0}}" FontSize="11" />
                <TextBlock Text="{Binding LayoutSummary, StringFormat=Layout analysis: {0}}" FontSize="11" TextWrapping="Wrap" />
                <TextBlock Text="{Binding TimingSummary}" FontSize="11" TextWrapping="Wrap" />
                <TextBlock Text="{Binding MathEndpointSummary, StringFormat=Text LLM: {0}}" FontSize="11" TextWrapping="Wrap" />
                <TextBlock Text="{Binding VisionEndpointSummary, StringFormat=Vision: {0}}" FontSize="11" TextWrapping="Wrap" />
                <TextBlock Text="{Binding CacheBytes, StringFormat=Speech cache: {0} bytes}" FontSize="11" />
                <ItemsControl ItemsSource="{Binding Notes}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <TextBlock Text="{Binding}" FontSize="11" TextWrapping="Wrap" Opacity="0.85" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </Expander>
        </Grid>
      </Border>
      <GridSplitter Name="SidebarSplitter" Grid.Column="1" Width="5" ResizeDirection="Columns"
                    Background="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    AutomationProperties.Name="Sidebar width" />

    <!-- Reading area. The first card over it appears only while a start is waiting for audio: what
         is being prepared and for how long, where the reader is looking, not only in the status bar.
         It does not take input, so the page can still be browsed or clicked underneath. -->
    <Panel Grid.Column="2">
      <views:PdfSurface Name="Surface" Focusable="True" />
      <Border IsVisible="{Binding IsPreparing}" IsHitTestVisible="False"
              HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,16,0,0"
              Padding="16,10" CornerRadius="8" MinWidth="320"
              Classes="overlayCard" BorderThickness="1">
        <StackPanel Spacing="8">
          <TextBlock Text="{Binding PreparationText}" FontSize="14"
                     TextAlignment="Center" TextWrapping="Wrap" />
          <!-- Indeterminate only while shown: a hidden indeterminate bar still animates, and on X11
               that kept a core busy (RailReader2's finding). -->
          <ProgressBar IsIndeterminate="{Binding IsPreparing}" Height="4" MinWidth="280" />
          <TextBlock Text="Not playing yet: reading starts as soon as the audio is ready."
                     Classes="secondary" FontSize="11" TextAlignment="Center" />
        </StackPanel>
      </Border>

      <!-- Opening a document. A veil over whatever was on screen (the previous document, or nothing)
           and a card in the middle of the reading area saying which file is being opened, what is
           being done to it and how far that has got. The veil takes the pointer, so a click cannot
           start the previous document reading underneath. The stage is a live region, so a screen
           reader announces each change. -->
      <!-- While a PDF is dragged over the window: where it will go. Takes no input. -->
      <Border Name="DropHint" IsVisible="False" IsHitTestVisible="False" Margin="24"
              Background="{DynamicResource OverlayVeilBrush}" CornerRadius="12"
              BorderBrush="{DynamicResource SystemControlHighlightAccentBrush}" BorderThickness="3">
        <Border Classes="overlayCard" BorderThickness="2" CornerRadius="12" Padding="28,20"
                HorizontalAlignment="Center" VerticalAlignment="Center">
          <StackPanel Spacing="10" HorizontalAlignment="Center">
            <c:Icon Data="{StaticResource IconFolderOpen}" SizeFactor="3" HorizontalAlignment="Center" />
            <TextBlock Name="DropHintText" FontSize="18" FontWeight="SemiBold" TextAlignment="Center" />
          </StackPanel>
        </Border>
      </Border>

      <Border Name="LoadingVeil" IsVisible="{Binding IsLoading}" Background="{DynamicResource OverlayVeilBrush}">
        <Border Name="LoadingCard" HorizontalAlignment="Center" VerticalAlignment="Center"
                Padding="32,26" CornerRadius="12" MinWidth="460" MaxWidth="640" Margin="24"
                Classes="overlayCard" BorderThickness="2">
          <StackPanel Spacing="12">
            <TextBlock Text="OPENING DOCUMENT" Classes="eyebrow" />
            <TextBlock Text="{Binding LoadingTitle}" FontSize="22" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap" />
            <TextBlock Name="LoadingStageText" Text="{Binding LoadingStage}" FontSize="17"
                       TextWrapping="Wrap" Margin="0,8,0,0"
                       AutomationProperties.LiveSetting="Polite" />
            <ProgressBar Name="LoadingBar" Height="10" MinWidth="400" CornerRadius="5"
                         Minimum="0" Maximum="1" Value="{Binding LoadingProgress}"
                         IsIndeterminate="{Binding LoadingIndeterminate}" />
            <TextBlock Text="{Binding LoadingDetail}" Classes="secondary" FontSize="14" MinHeight="20" />
            <TextBlock Text="The pages are analysed once and remembered: this document opens faster next time."
                       Classes="secondary" FontSize="12" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </Border>
    </Panel>
    </Grid>
  </DockPanel>
</Window>
