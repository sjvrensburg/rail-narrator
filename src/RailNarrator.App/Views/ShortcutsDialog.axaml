<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RailNarrator.App.Views.ShortcutsDialog"
        Title="Keyboard shortcuts" Width="460" Height="620" MinWidth="380" MinHeight="300"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Window.Styles>
    <Style Selector="TextBlock.group">
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Margin" Value="0,12,0,4" />
    </Style>
    <Style Selector="TextBlock.key">
      <Setter Property="FontFamily" Value="monospace" />
      <Setter Property="Margin" Value="0,2,16,2" />
    </Style>
    <Style Selector="TextBlock.what">
      <Setter Property="Margin" Value="0,2" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </Window.Styles>
  <DockPanel Margin="16">
    <Button DockPanel.Dock="Bottom" Content="Close" MinWidth="80" HorizontalAlignment="Right" Margin="0,12,0,0"
            Click="OnClose" IsCancel="True" />
    <ScrollViewer>
      <StackPanel Name="Groups" />
    </ScrollViewer>
  </DockPanel>
</Window>
