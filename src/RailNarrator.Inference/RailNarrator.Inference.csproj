<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>RailNarrator.Inference</RootNamespace>
    <Description>Mathematical interpretation, transcription and verbalisation over an OpenAI-compatible endpoint or Claude, with closed-schema validation.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../RailNarrator.Domain/RailNarrator.Domain.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="RailNarrator.Inference.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- Reused for crop-to-LaTeX transcription only. Verbalisation is a separate service here;
         Core's IVlmService semantics are deliberately not changed. -->
    <PackageReference Include="RailReader.Core" />
    <PackageReference Include="RailReader.Core.Vlm.OpenAI" />
    <PackageReference Include="RailReader.Core.Vlm.Anthropic" />
    <!-- Claude for interpretation and verbalisation, which do not go through Core. -->
    <PackageReference Include="Anthropic" />
  </ItemGroup>
</Project>
