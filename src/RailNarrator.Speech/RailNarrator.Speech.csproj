<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>RailNarrator.Speech</RootNamespace>
    <Description>TTS provider adapters (in-process Kokoro and Phonon, ZONOS3 sidecar) plus PCM/WAV codecs.</Description>
    <!-- Phonon's C library calls back into managed code through a function pointer. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../RailNarrator.Domain/RailNarrator.Domain.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="KokoroSharp.CPU" />
    <EmbeddedResource Include="alignment_worker.py" />
  </ItemGroup>
</Project>
