index 0000000..06a6e8a
--- /dev/null
+++ b/ptts/src/align.rs
@@ -0,0 +1,113 @@
+//! A tap on one attention head of the flow LM, for word timing (not part of upstream Phonon).
+//!
+//! One head of one layer follows the text as the audio is generated: at each 80 ms frame nearly
+//! all of its attention sits on the text token being spoken. A caller that wants word times
+//! installs the tap, speaks, and drains what it recorded: for each chunk of text its token ids,
+//! and for each frame that head's attention over those tokens.
+//!
+//! The tap is one per process. Generation is one utterance at a time for a caller of the C
+//! interface, which is the only user; two utterances at once would mix their rows.
+
+use std::sync::Mutex;
+
+/// What the tap recorded, in order.
+pub enum Event {
+    /// A chunk of text starts: its token ids, as the model was given them.
+    Chunk(Vec<u32>),
+    /// One generated frame: the head's attention over the chunk's tokens.
+    Frame(Vec<f32>),
+}
+
+struct Tap {
+    layer: usize,
+    head: usize,
+    /// The thread generating frames; other threads (the codec's) run attention too.
+    thread: Option<std::thread::ThreadId>,
+    /// Attention calls seen since the step began: the flow LM's layers, in order.
+    calls: usize,
+    /// This step's row over every key, once the layer has run.
+    row: Option<Vec<f32>>,
+    tokens: usize,
+    /// Where the chunk's text tokens start among the keys, known from its first frame.
+    text_start: Option<usize>,
+    events: Vec<Event>,
+}
+
+static TAP: Mutex<Option<Tap>> = Mutex::new(None);
+
+fn with<R>(f: impl FnOnce(&mut Tap) -> R) -> Option<R> {
+    TAP.lock().ok()?.as_mut().map(f)
+}
+
+/// Record `head` of layer `layer` (both from 0) from now on.
+pub fn install(layer: usize, head: usize) {
+    if let Ok(mut tap) = TAP.lock() {
+        *tap = Some(Tap {
+            layer,
+            head,
+            thread: None,
+            calls: 0,
+            row: None,
+            tokens: 0,
+            text_start: None,
+            events: Vec::new(),
+        });
+    }
+}
+
+/// Stop recording and drop what was not drained.
+pub fn remove() {
+    if let Ok(mut tap) = TAP.lock() {
+        *tap = None;
+    }
+}
+
+/// Take what was recorded since the last call.
+pub fn drain() -> Vec<Event> {
+    with(|t| std::mem::take(&mut t.events)).unwrap_or_default()
+}
+
+pub(crate) fn begin_chunk(tokens: &[u32]) {
+    with(|t| {
+        t.tokens = tokens.len();
+        t.text_start = None;
+        t.events.push(Event::Chunk(tokens.to_vec()));
+    });
+}
+
+pub(crate) fn begin_step() {
+    with(|t| {
+        t.thread = Some(std::thread::current().id());
+        t.calls = 0;
+        t.row = None;
+    });
+}
+
+/// Whether the attention call now running is the one to record, and which head. Counts the call.
+pub(crate) fn wants() -> Option<usize> {
+    with(|t| {
+        if t.thread != Some(std::thread::current().id()) {
+            return None;
+        }
+        let call = t.calls;
+        t.calls += 1;
+        (call == t.layer).then_some(t.head)
+    })
+    .flatten()
+}
+
+/// The recorded head's attention over the keys filled so far.
+pub(crate) fn record(row: Vec<f32>) {
+    with(|t| t.row = Some(row));
+}
+
+pub(crate) fn end_step() {
+    with(|t| {
+        let Some(row) = t.row.take() else { return };
+        // The keys are the voice, then the text, then one row per frame so far and the row of
+        // this step: at a chunk's first frame the text ends one key before the end.
+        let start = *t.text_start.get_or_insert(row.len().saturating_sub(1 + t.tokens));
+        let end = (start + t.tokens).min(row.len());
+        t.events.push(Event::Frame(row[start.min(end)..end].to_vec()));
+    });
+}
