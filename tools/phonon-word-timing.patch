+impl Engine {
+    /// [`Self::speak`], also reporting what word timing is made from (see `ptts::align`): for
+    /// each chunk of text, the text as the model was given it with the byte offset at which each
+    /// of its tokens ends, then for each frame of that chunk the attention of `head` in `layer`
+    /// over those tokens. Chunks and frames are reported in order, on the calling thread, some
+    /// of them only after the audio they belong to.
+    pub fn speak_aligned(
+        &mut self,
+        text: &str,
+        layer: usize,
+        head: usize,
+        sink: &mut dyn FnMut(&[f32]) -> bool,
+        on_chunk: &mut dyn FnMut(&str, &[u32]),
+        on_frame: &mut dyn FnMut(&[f32]),
+    ) -> Result<PttsResult, String> {
+        use ptts::Tokenizer as _;
+        if self.tokenizer.is_none() {
+            return Err("word timing needs the checkpoint's tokenizer.json".to_string());
+        }
+        ptts::align::install(layer, head);
+        let mut report = |tokenizer: &ptts::tok::Tok| {
+            for event in ptts::align::drain() {
+                match event {
+                    ptts::align::Event::Chunk(ids) => {
+                        let text = tokenizer.decode(&ids).unwrap_or_default();
+                        let mut ends = Vec::with_capacity(ids.len());
+                        let mut last = 0u32;
+                        for k in 0..ids.len() {
+                            let upto = tokenizer.decode(&ids[..=k]).map(|s| s.len()).unwrap_or(0);
+                            last = last.max(upto.min(text.len()) as u32);
+                            ends.push(last);
+                        }
+                        if let Some(end) = ends.last_mut() {
+                            *end = text.len() as u32;
+                        }
+                        on_chunk(&text, &ends);
+                    }
+                    ptts::align::Event::Frame(scores) => on_frame(&scores),
+                }
+            }
+        };
+        let tokenizer = self.tokenizer.take();
+        let result = self.speak(text, &mut |pcm: &[f32]| {
+            if let Some(t) = tokenizer.as_ref() {
+                report(t);
+            }
+            sink(pcm)
+        });
+        // The stream has ended and its threads are joined: everything is recorded.
+        if let Some(t) = tokenizer.as_ref() {
+            report(t);
+        }
+        self.tokenizer = tokenizer;
+        ptts::align::remove();
+        result
+    }
+}
