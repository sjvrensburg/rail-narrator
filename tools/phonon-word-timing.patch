+/// Called once for each chunk of text before its frames: the text as the model was given it
+/// (NUL-terminated UTF-8) and, for each of its `n` tokens, the byte offset in it where the token ends.
+pub type PttsChunkFn = extern "C" fn(*const c_char, *const u32, usize, *mut c_void);
+
+/// Called once for each generated frame (80 ms of audio) of the current chunk, in order: the
+/// attention of the chosen head over the chunk's `n` tokens.
+pub type PttsAlignFn = extern "C" fn(*const f32, usize, *mut c_void);
+
+/// `ptts_speak`, also reporting what word timing can be made from: `chunk_cb` for each chunk of
+/// the text and `align_cb` for each frame, with the attention of head `head` of layer `layer`
+/// (both from 0) of the language model. The CPU engine only. Not part of upstream Phonon.
+///
+/// # Safety
+/// As `ptts_speak`; `chunk_cb` and `align_cb` must be valid for the duration of the call.
+#[cfg(not(target_vendor = "apple"))]
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn ptts_speak_aligned(
+    h: *mut PttsHandle,
+    text: *const c_char,
+    cb: PttsFrameFn,
+    layer: u32,
+    head: u32,
+    chunk_cb: PttsChunkFn,
+    align_cb: PttsAlignFn,
+    user: *mut c_void,
+    out: *mut PttsResult,
+) -> bool {
+    let h = unsafe { &mut *h };
+    let text = unsafe { CStr::from_ptr(text) }.to_string_lossy().to_string();
+    let r = guarded(|| {
+        h.engine.speak_aligned(
+            &text,
+            layer as usize,
+            head as usize,
+            &mut |pcm: &[f32]| cb(pcm.as_ptr(), pcm.len(), user),
+            &mut |chunk: &str, ends: &[u32]| {
+                let chunk = c_string(chunk);
+                chunk_cb(chunk.as_ptr(), ends.as_ptr(), ends.len(), user)
+            },
+            &mut |scores: &[f32]| align_cb(scores.as_ptr(), scores.len(), user),
+        )
+    });
+    match r {
+        Ok(r) => {
+            unsafe { *out = r };
+            true
+        }
+        Err(e) => {
+            h.last_error = Some(c_string(&e));
+            false
+        }
+    }
+}
